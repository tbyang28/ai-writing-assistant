# 必填：JWT 加密密钥，请替换为强密码
SECRET_KEY=change-this-to-a-strong-secret-key

# 主后端数据库（PostgreSQL + pgvector）
DATABASE_URL=postgres://postgres:postgres@postgres:5432/ai_writing
RUN_MIGRATIONS=true

# 旧 Python 参考服务专用（可选，不参与主链路）
PYTHON_DATABASE_URL=sqlite+aiosqlite:////app/data/writing_platform.db

# JWT 配置
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SiliconFlow API（AI 功能必需）
SILICONFLOW_API_KEY=your-api-key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
DEEPSEEK_MODEL=deepseek-ai/DeepSeek-V4-Flash

# 同域名反代部署时保持为空，前端会用相对路径 /api/ 访问后端
VITE_API_URL=
